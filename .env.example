# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# Security Configuration
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Database Configuration
# Default is local SQLite. To use MySQL, set:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/music_rec
DATABASE_URL=sqlite:///music_rec.db
